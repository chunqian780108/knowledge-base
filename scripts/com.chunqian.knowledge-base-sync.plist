<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chunqian.knowledge-base-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__VAULT__/scripts/sync-to-github.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/chq118/Library/Logs/knowledge-base-sync-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/chq118/Library/Logs/knowledge-base-sync-stderr.log</string>

    <key>WorkingDirectory</key>
    <string>__VAULT__</string>
</dict>
</plist>
